# ==========================================
# Cấu hình Môi trường Docker Compose POS Store
# ==========================================

# 1. Ứng dụng Node.js / Express
PORT=3000
HOST=0.0.0.0
SESSION_SECRET=change_me_to_a_very_secure_random_string_32chars
INITIAL_MANAGER_PASSWORD=ChangeThisStrongPass123!

# 2. Cơ sở dữ liệu MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pos_store
DB_USER=pos_app
DB_PASSWORD=change_me_secure_app_password
MYSQL_ROOT_PASSWORD=change_me_secure_root_password

# 3. Prometheus Metrics Endpoint (Node.js)
METRICS_PORT=9101
METRICS_HOST=0.0.0.0

# 4. Cấu hình thanh toán VietQR (Tùy chọn)
VIETQR_BANK_ID=970415
VIETQR_BANK_NAME=VietinBank
VIETQR_ACCOUNT_NO=your_account_number_here
VIETQR_ACCOUNT_NAME="NGUYEN VAN A"

# 5. Cổng Host ánh xạ tới máy chủ cá nhân (127.0.0.1)
# Tránh xung đột với cổng dịch vụ đang chạy trên Windows
HOST_NGINX_PORT=8080
HOST_APP_PORT=3000
HOST_METRICS_PORT=9101
HOST_PMA_PORT=8081
HOST_MYSQL_PORT=3307
HOST_PROMETHEUS_PORT=9090
HOST_GRAFANA_PORT=3001
HOST_LOKI_PORT=3100
HOST_ALLOY_PORT=12345

# 6. Quản trị Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
