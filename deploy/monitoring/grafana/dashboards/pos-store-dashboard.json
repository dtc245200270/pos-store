          "editorMode": "code",
          "expr": "((sum(rate(http_requests_total{job=\"pos_store\", status_code=~\"5..\"}[1m])) or (sum(rate(http_requests_total{job=\"pos_store\"}[1m])) * 0)) / (sum(rate(http_requests_total{job=\"pos_store\"}[1m])) > 0)) * 100",
